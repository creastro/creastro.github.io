{
  "name": "psf-simulator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "build:site": "vite build -c vite.site.main.config.ts && vite build -c vite.site.worker.config.ts",
    "build": "tsc -b && npm run build:site"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
